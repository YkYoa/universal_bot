<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sequence_executor</name>
  <version>0.1.0</version>
  <description>
    Two-layer robot state machine: a supervisory layer (idle/running/paused/
    fault/estop/teaching) over a sequence layer that walks an ordered step
    list. Serves RunSequence, FsmCommand, and a latched FsmState topic.
    Sequences come from a pluggable SequenceSource - a sequence.yaml here, or
    a project's own store.
  </description>
  <maintainer email="hans@openarm.dev">hans</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>controller_manager_msgs</depend>

  <depend>yaml-cpp</depend>

  <!-- Planner profile loader (in-process library) -->
  <depend>planning_interface</depend>
  <depend>openarm_messages</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

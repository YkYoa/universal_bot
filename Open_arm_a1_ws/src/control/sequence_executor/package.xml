<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sequence_executor</name>
  <version>0.1.0</version>
  <description>
    Reads sequence.yaml directly and replays its sequences: entries as a
    plain event-driven state machine (home step once, then a looped body) -
    replaces bt_executor/BehaviorTree.CPP for this workspace.
  </description>
  <maintainer email="hans@openarm.dev">hans</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>controller_manager_msgs</depend>

  <depend>yaml-cpp</depend>

  <!-- Planner profile loader (in-process library) -->
  <depend>planning_interface</depend>
  <depend>openarm_messages</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

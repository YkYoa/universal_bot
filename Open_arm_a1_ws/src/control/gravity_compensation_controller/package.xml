<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gravity_compensation_controller</name>
  <version>0.0.0</version>
  <description>
    Joint-space gravity compensation controller (KDL-based) for free-drive /
    hand-guiding under OpenArm_v10HW's torque control_mode. No Coriolis/
    inertia compensation, no Cartesian/wrench estimation - static gravity
    torque only.
  </description>
  <maintainer email="hans@todo.todo">hans</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>kdl_parser</depend>
  <depend>orocos_kdl_vendor</depend>
  <depend>std_srvs</depend>
  <depend>urdf</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

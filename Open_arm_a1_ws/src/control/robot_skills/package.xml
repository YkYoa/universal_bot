<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_skills</name>
  <version>0.1.0</version>
  <description>Clean Robot Skills API package using MoveItCpp</description>
  <maintainer email="hans@openarm.dev">hans</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>planning_interface</depend>
  <depend>motion_planner</depend>
  <depend>openarm_messages</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

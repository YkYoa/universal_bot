<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bt_executor</name>
  <version>0.1.0</version>
  <description>
    Behavior Tree executor for OpenArm VLA system.
    Bridges the VLA perception layer to the MoveIt2 motion stack
    via a BehaviorTree.CPP v4 tick loop.
    Features: planner profile selection, reactive replanning.
  </description>
  <maintainer email="hans@openarm.dev">hans</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- BehaviorTree.CPP v4 -->
  <depend>behaviortree_cpp</depend>

  <!-- behaviortree_ros2 wraps BT nodes as ROS 2 action/service clients -->
  <depend>behaviortree_ros2</depend>

  <!-- ROS 2 core -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>

  <!-- Message types -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>

  <!-- MoveIt 2 -->
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>

  <!-- Planner profile loader (in-process library) -->
  <depend>planner_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

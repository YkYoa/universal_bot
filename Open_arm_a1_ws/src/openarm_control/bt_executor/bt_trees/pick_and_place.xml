<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="PickAndPlace">
  <BehaviorTree ID="PickAndPlace">
    <Fallback name="root_fallback">

      <Sequence name="vla_instruction_following">
        <!-- ── Step 1: Initialize ─────────────────────────────────────── -->
        <!-- Move arm to the safe custom "vla_ready" starting pose once.   -->
        <!-- This unfolds the arm high above the table, providing a safe   -->
        <!-- initial posture that prevents collisions and enables IK       -->
        <!-- solvers to plan Cartesian moves smoothly.                     -->
        <!-- <SetPlannerConfig profile="safe_rrt" /> -->
        <!-- <PlanToNamedPose arm="{plan_active_arm}" pose_name="vla_ready" duration="3.0" output_trajectory="{plan_trajectory}" />
        <ExecuteTrajectory trajectory="{plan_trajectory}" /> -->

        <!-- ── Step 2: Continuous VLA Instruction Loop ───────────────── -->
        <!-- Loops QueryVLA continuously. The arm stays exactly at its  -->
        <!-- last reached pose and queries the model again from there,  -->
        <!-- with no home/ready movements in between.                    -->
        <KeepRunningUntilFailure>
          <Sequence name="vla_query_and_execute">
            <QueryVLA task="{vla_task_name}" />
            <Sleep msec="1000" />
          </Sequence>
        </KeepRunningUntilFailure>
      </Sequence>

      <!-- ── Fallback Safe Abort ───────────────────────────────────── -->
      <ForceSuccess>
        <SafeAbort reason="vla_execution_failed" />
      </ForceSuccess>

    </Fallback>
  </BehaviorTree>
</root>

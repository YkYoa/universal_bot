<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF for the OpenArm bimanual robot.
  Defines planning groups, end-effectors, and default poses.
-->
<robot name="openarm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================ -->
  <!-- LEFT ARM planning group (7-DOF)              -->
  <!-- ============================================ -->
  <group name="left_arm">
    <chain base_link="openarm_body_link0" tip_link="openarm_left_hand_tcp"/>
  </group>

  <!-- ============================================ -->
  <!-- RIGHT ARM planning group (7-DOF)             -->
  <!-- ============================================ -->
  <group name="right_arm">
    <chain base_link="openarm_body_link0" tip_link="openarm_right_hand_tcp"/>
  </group>

  <!-- ============================================ -->
  <!-- BOTH ARMS planning group                     -->
  <!-- ============================================ -->
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- ============================================ -->
  <!-- LEFT GRIPPER                                 -->
  <!-- ============================================ -->
  <group name="left_gripper">
    <joint name="openarm_left_finger_joint1"/>
    <joint name="openarm_left_finger_joint2"/>
  </group>

  <!-- ============================================ -->
  <!-- RIGHT GRIPPER                                -->
  <!-- ============================================ -->
  <group name="right_gripper">
    <joint name="openarm_right_finger_joint1"/>
    <joint name="openarm_right_finger_joint2"/>
  </group>

  <!-- ============================================ -->
  <!-- AMAZING HAND FINGERS                         -->
  <!-- Only valid when the robot is built with       -->
  <!-- ee_type:=amazing_hand (mutually exclusive     -->
  <!-- with left_gripper/right_gripper above, which  -->
  <!-- are the default ee_type:=openarm_hand groups) -->
  <!-- j1<i> = yaw/abduction, j2<i> = proximal flex  -->
  <!-- of finger i (i=1..3 top-down, 4=thumb).       -->
  <!-- Distal knuckle is mechanically coupled to     -->
  <!-- flexion through the linkage, not independent. -->
  <!-- ============================================ -->
  <group name="left_hand_fingers">
    <joint name="openarm_left_j11"/>
    <joint name="openarm_left_j12"/>
    <joint name="openarm_left_j13"/>
    <joint name="openarm_left_j14"/>
    <joint name="openarm_left_j21"/>
    <joint name="openarm_left_j22"/>
    <joint name="openarm_left_j23"/>
    <joint name="openarm_left_j24"/>
  </group>

  <group name="right_hand_fingers">
    <joint name="openarm_right_j11"/>
    <joint name="openarm_right_j12"/>
    <joint name="openarm_right_j13"/>
    <joint name="openarm_right_j14"/>
    <joint name="openarm_right_j21"/>
    <joint name="openarm_right_j22"/>
    <joint name="openarm_right_j23"/>
    <joint name="openarm_right_j24"/>
  </group>

  <!-- ============================================ -->
  <!-- End Effectors                                -->
  <!-- ============================================ -->
  <end_effector name="left_hand" parent_link="openarm_left_hand_tcp" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_hand" parent_link="openarm_right_hand_tcp" group="right_gripper" parent_group="right_arm"/>

  <!-- ============================================ -->
  <!-- Default poses                                -->
  <!-- ============================================ -->
  <group_state name="home" group="left_arm">
    <joint name="openarm_left_joint1" value="0.0"/>
    <joint name="openarm_left_joint2" value="0.0"/>
    <joint name="openarm_left_joint3" value="0.0"/>
    <joint name="openarm_left_joint4" value="0.0"/>
    <joint name="openarm_left_joint5" value="0.0"/>
    <joint name="openarm_left_joint6" value="0.0"/>
    <joint name="openarm_left_joint7" value="0.0"/>
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="openarm_right_joint1" value="0.0"/>
    <joint name="openarm_right_joint2" value="0.0"/>
    <joint name="openarm_right_joint3" value="0.0"/>
    <joint name="openarm_right_joint4" value="0.0"/>
    <joint name="openarm_right_joint5" value="0.0"/>
    <joint name="openarm_right_joint6" value="0.0"/>
    <joint name="openarm_right_joint7" value="0.0"/>
  </group_state>

  <group_state name="ready" group="left_arm">
    <joint name="openarm_left_joint1" value="0.0"/>
    <joint name="openarm_left_joint2" value="0.0"/>
    <joint name="openarm_left_joint3" value="0.0"/>
    <joint name="openarm_left_joint4" value="1.57"/>
    <joint name="openarm_left_joint5" value="0.0"/>
    <joint name="openarm_left_joint6" value="0.0"/>
    <joint name="openarm_left_joint7" value="0.0"/>
  </group_state>

  <group_state name="ready" group="right_arm">
    <joint name="openarm_right_joint1" value="0.0"/>
    <joint name="openarm_right_joint2" value="0.0"/>
    <joint name="openarm_right_joint3" value="0.0"/>
    <joint name="openarm_right_joint4" value="1.57"/>
    <joint name="openarm_right_joint5" value="0.0"/>
    <joint name="openarm_right_joint6" value="0.0"/>
    <joint name="openarm_right_joint7" value="0.0"/>
  </group_state>

  <group_state name="vla_ready" group="left_arm">
    <joint name="openarm_left_joint1" value="0.7147"/>
    <joint name="openarm_left_joint2" value="-0.5379"/>
    <joint name="openarm_left_joint3" value="-0.0589"/>
    <joint name="openarm_left_joint4" value="2.3408"/>
    <joint name="openarm_left_joint5" value="-0.4394"/>
    <joint name="openarm_left_joint6" value="0.3262"/>
    <joint name="openarm_left_joint7" value="0.6996"/>
  </group_state>

  <group_state name="vla_ready" group="right_arm">
    <joint name="openarm_right_joint1" value="-0.7147"/>
    <joint name="openarm_right_joint2" value="-0.5379"/>
    <joint name="openarm_right_joint3" value="0.0589"/>
    <joint name="openarm_right_joint4" value="2.3408"/>
    <joint name="openarm_right_joint5" value="0.4394"/>
    <joint name="openarm_right_joint6" value="0.3262"/>
    <joint name="openarm_right_joint7" value="-0.6996"/>
  </group_state>

  <group_state name="open" group="left_gripper">
    <joint name="openarm_left_finger_joint1" value="0.044"/>
    <joint name="openarm_left_finger_joint2" value="0.044"/>
  </group_state>

  <group_state name="close" group="left_gripper">
    <joint name="openarm_left_finger_joint1" value="0.0"/>
    <joint name="openarm_left_finger_joint2" value="0.0"/>
  </group_state>

  <group_state name="open" group="right_gripper">
    <joint name="openarm_right_finger_joint1" value="0.044"/>
    <joint name="openarm_right_finger_joint2" value="0.044"/>
  </group_state>

  <group_state name="close" group="right_gripper">
    <joint name="openarm_right_finger_joint1" value="0.0"/>
    <joint name="openarm_right_finger_joint2" value="0.0"/>
  </group_state>

  <group_state name="open" group="left_hand_fingers">
    <joint name="openarm_left_j11" value="0.0"/>
    <joint name="openarm_left_j12" value="0.0"/>
    <joint name="openarm_left_j13" value="0.0"/>
    <joint name="openarm_left_j14" value="0.0"/>
    <joint name="openarm_left_j21" value="0.0"/>
    <joint name="openarm_left_j22" value="0.0"/>
    <joint name="openarm_left_j23" value="0.0"/>
    <joint name="openarm_left_j24" value="0.0"/>
  </group_state>

  <group_state name="close" group="left_hand_fingers">
    <joint name="openarm_left_j11" value="0.0"/>
    <joint name="openarm_left_j12" value="0.0"/>
    <joint name="openarm_left_j13" value="0.0"/>
    <joint name="openarm_left_j14" value="0.0"/>
    <joint name="openarm_left_j21" value="1.0"/>
    <joint name="openarm_left_j22" value="1.0"/>
    <joint name="openarm_left_j23" value="1.0"/>
    <joint name="openarm_left_j24" value="1.0"/>
  </group_state>

  <group_state name="open" group="right_hand_fingers">
    <joint name="openarm_right_j11" value="0.0"/>
    <joint name="openarm_right_j12" value="0.0"/>
    <joint name="openarm_right_j13" value="0.0"/>
    <joint name="openarm_right_j14" value="0.0"/>
    <joint name="openarm_right_j21" value="0.0"/>
    <joint name="openarm_right_j22" value="0.0"/>
    <joint name="openarm_right_j23" value="0.0"/>
    <joint name="openarm_right_j24" value="0.0"/>
  </group_state>

  <group_state name="close" group="right_hand_fingers">
    <joint name="openarm_right_j11" value="0.0"/>
    <joint name="openarm_right_j12" value="0.0"/>
    <joint name="openarm_right_j13" value="0.0"/>
    <joint name="openarm_right_j14" value="0.0"/>
    <joint name="openarm_right_j21" value="1.0"/>
    <joint name="openarm_right_j22" value="1.0"/>
    <joint name="openarm_right_j23" value="1.0"/>
    <joint name="openarm_right_j24" value="1.0"/>
  </group_state>

  <!-- Thumb (j24) pre-flexed to 75deg = 1.308997 rad so the hand's resting
       pose doesn't rest flat against the torso; matches the ros2_control
       initial_value set in ahand.ros2_control.xacro. -->
  <group_state name="home" group="left_hand_fingers">
    <joint name="openarm_left_j11" value="0.0"/>
    <joint name="openarm_left_j12" value="0.0"/>
    <joint name="openarm_left_j13" value="0.0"/>
    <joint name="openarm_left_j14" value="0.0"/>
    <joint name="openarm_left_j21" value="0.0"/>
    <joint name="openarm_left_j22" value="0.0"/>
    <joint name="openarm_left_j23" value="0.0"/>
    <joint name="openarm_left_j24" value="1.308997"/>
  </group_state>

  <group_state name="home" group="right_hand_fingers">
    <joint name="openarm_right_j11" value="0.0"/>
    <joint name="openarm_right_j12" value="0.0"/>
    <joint name="openarm_right_j13" value="0.0"/>
    <joint name="openarm_right_j14" value="0.0"/>
    <joint name="openarm_right_j21" value="0.0"/>
    <joint name="openarm_right_j22" value="0.0"/>
    <joint name="openarm_right_j23" value="0.0"/>
    <joint name="openarm_right_j24" value="1.308997"/>
  </group_state>

  <group_state name="home" group="both_arms">
    <joint name="openarm_left_joint1" value="0.0"/>
    <joint name="openarm_left_joint2" value="0.0"/>
    <joint name="openarm_left_joint3" value="0.0"/>
    <joint name="openarm_left_joint4" value="0.0"/>
    <joint name="openarm_left_joint5" value="0.0"/>
    <joint name="openarm_left_joint6" value="0.0"/>
    <joint name="openarm_left_joint7" value="0.0"/>
    <joint name="openarm_right_joint1" value="0.0"/>
    <joint name="openarm_right_joint2" value="0.0"/>
    <joint name="openarm_right_joint3" value="0.0"/>
    <joint name="openarm_right_joint4" value="0.0"/>
    <joint name="openarm_right_joint5" value="0.0"/>
    <joint name="openarm_right_joint6" value="0.0"/>
    <joint name="openarm_right_joint7" value="0.0"/>
  </group_state>

  <group_state name="ready" group="both_arms">
    <joint name="openarm_left_joint1" value="0.0"/>
    <joint name="openarm_left_joint2" value="0.0"/>
    <joint name="openarm_left_joint3" value="0.0"/>
    <joint name="openarm_left_joint4" value="1.57"/>
    <joint name="openarm_left_joint5" value="0.0"/>
    <joint name="openarm_left_joint6" value="0.0"/>
    <joint name="openarm_left_joint7" value="0.0"/>
    <joint name="openarm_right_joint1" value="0.0"/>
    <joint name="openarm_right_joint2" value="0.0"/>
    <joint name="openarm_right_joint3" value="0.0"/>
    <joint name="openarm_right_joint4" value="1.57"/>
    <joint name="openarm_right_joint5" value="0.0"/>
    <joint name="openarm_right_joint6" value="0.0"/>
    <joint name="openarm_right_joint7" value="0.0"/>
  </group_state>

  <!-- ============================================ -->
  <!-- Disable self-collision between links that    -->
  <!-- are always or often in collision (adjacent)  -->
  <!-- ============================================ -->
  <!-- Adjacent link pairs - left arm -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_left_link0" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link0" link2="openarm_left_link1" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link1" link2="openarm_left_link2" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link2" link2="openarm_left_link3" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link3" link2="openarm_left_link4" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link4" link2="openarm_left_link5" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link5" link2="openarm_left_link6" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link6" link2="openarm_left_link7" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_link7" link2="openarm_left_hand" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_hand" link2="openarm_left_hand_tcp" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_hand" link2="openarm_left_left_finger" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_hand" link2="openarm_left_right_finger" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_left_finger" link2="openarm_left_right_finger" reason="Default"/>
  <disable_collisions link1="openarm_left_left_finger" link2="openarm_left_hand_tcp" reason="Never"/>
  <disable_collisions link1="openarm_left_right_finger" link2="openarm_left_hand_tcp" reason="Never"/>
  <disable_collisions link1="openarm_left_left_finger" link2="openarm_left_link7" reason="Never"/>
  <disable_collisions link1="openarm_left_right_finger" link2="openarm_left_link7" reason="Never"/>

  <!-- Adjacent link pairs - right arm -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_right_link0" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link0" link2="openarm_right_link1" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link1" link2="openarm_right_link2" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link2" link2="openarm_right_link3" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link3" link2="openarm_right_link4" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link4" link2="openarm_right_link5" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link5" link2="openarm_right_link6" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link6" link2="openarm_right_link7" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_link7" link2="openarm_right_hand" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_hand" link2="openarm_right_hand_tcp" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_hand" link2="openarm_right_left_finger" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_hand" link2="openarm_right_right_finger" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_left_finger" link2="openarm_right_right_finger" reason="Default"/>
  <disable_collisions link1="openarm_right_left_finger" link2="openarm_right_hand_tcp" reason="Never"/>
  <disable_collisions link1="openarm_right_right_finger" link2="openarm_right_hand_tcp" reason="Never"/>
  <disable_collisions link1="openarm_right_left_finger" link2="openarm_right_link7" reason="Never"/>
  <disable_collisions link1="openarm_right_right_finger" link2="openarm_right_link7" reason="Never"/>

  <!-- Cross-arm collisions (arms are mounted very close together) -->
  <disable_collisions link1="openarm_left_link0" link2="openarm_right_link0" reason="Never"/>
  <disable_collisions link1="openarm_left_link0" link2="openarm_right_link1" reason="Never"/>
  <disable_collisions link1="openarm_left_link1" link2="openarm_right_link0" reason="Never"/>
  <disable_collisions link1="openarm_left_link1" link2="openarm_right_link1" reason="Never"/>
  <disable_collisions link1="openarm_left_link2" link2="openarm_right_link0" reason="Never"/>
  <disable_collisions link1="openarm_left_link0" link2="openarm_right_link2" reason="Never"/>

  <!-- Base to body. openarm_base_link is an empty anchor (see openarm_base.xacro's
       floor_offset_joint) - the real mesh-bearing link body/wheels/casters actually
       touch is openarm_base_link_body. -->
  <disable_collisions link1="openarm_base_link_body" link2="openarm_body_link0" reason="Adjacent"/>

  <!-- Body to its own neck/head chain (body_type:=v2 only; harmless no-op link
       names otherwise since they just won't exist in the URDF) -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_body_neck_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_body_neck_link" link2="openarm_body_head_link" reason="Adjacent"/>

  <!-- Body to nearby arm links (arms mount on body, overlapping geometry) -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_left_link1" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_left_link2" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_right_link1" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_right_link2" reason="Never"/>

  <!-- Body to amazing_hand at rest (arm's default all-zero pose folds the hand
       in close enough for proximal_3 to overlap the torso; found via
       GetStateValidity on the default start state, which was blocking ALL
       arm-group planning, not just head/neck) -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_left_ahand_proximal_3" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_right_ahand_proximal_3" reason="Never"/>

  <!-- amazing_hand internal: proximal_1/proximal_2 overlap the (thumb?) proximal
       segment at rest - same GetStateValidity finding as above, right hand only
       (left hand's mirrored geometry didn't show the same contact) -->
  <disable_collisions link1="openarm_right_ahand_proximal_1" link2="openarm_right_ahand_proximal" reason="Never"/>
  <disable_collisions link1="openarm_right_ahand_proximal_2" link2="openarm_right_ahand_proximal" reason="Never"/>

  <!-- Body to base wheels/casters (body cage extends into base area) -->
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_right_drive_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_left_drive_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_fr_caster_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_fl_caster_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_br_caster_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_bl_caster_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_fr_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_fl_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_br_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_body_link0" link2="openarm_base_bl_wheel_link" reason="Never"/>

  <!-- Base wheels (real adjacency is to openarm_base_link_body, the mesh/wheels
       link - see comment above) -->
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_right_drive_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_left_drive_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_fr_caster_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_fl_caster_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_br_caster_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_bl_caster_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_fr_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_fl_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_br_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_base_link_body" link2="openarm_base_bl_wheel_link" reason="Never"/>
  <disable_collisions link1="openarm_base_fr_caster_link" link2="openarm_base_fr_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_fl_caster_link" link2="openarm_base_fl_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_br_caster_link" link2="openarm_base_br_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="openarm_base_bl_caster_link" link2="openarm_base_bl_wheel_link" reason="Adjacent"/>

  <!-- Never-in-collision pairs (distant links) -->
  <disable_collisions link1="openarm_left_link0" link2="openarm_left_link2" reason="Never"/>
  <disable_collisions link1="openarm_left_link0" link2="openarm_left_link3" reason="Never"/>
  <disable_collisions link1="openarm_left_link1" link2="openarm_left_link3" reason="Never"/>
  <disable_collisions link1="openarm_left_link1" link2="openarm_left_link4" reason="Never"/>
  <disable_collisions link1="openarm_left_link2" link2="openarm_left_link4" reason="Never"/>
  <disable_collisions link1="openarm_left_link2" link2="openarm_left_link5" reason="Never"/>
  <disable_collisions link1="openarm_left_link3" link2="openarm_left_link5" reason="Never"/>
  <disable_collisions link1="openarm_left_link3" link2="openarm_left_link6" reason="Never"/>
  <disable_collisions link1="openarm_left_link4" link2="openarm_left_link6" reason="Never"/>
  <disable_collisions link1="openarm_left_link4" link2="openarm_left_link7" reason="Never"/>
  <disable_collisions link1="openarm_left_link5" link2="openarm_left_link7" reason="Never"/>

  <disable_collisions link1="openarm_right_link0" link2="openarm_right_link2" reason="Never"/>
  <disable_collisions link1="openarm_right_link0" link2="openarm_right_link3" reason="Never"/>
  <disable_collisions link1="openarm_right_link1" link2="openarm_right_link3" reason="Never"/>
  <disable_collisions link1="openarm_right_link1" link2="openarm_right_link4" reason="Never"/>
  <disable_collisions link1="openarm_right_link2" link2="openarm_right_link4" reason="Never"/>
  <disable_collisions link1="openarm_right_link2" link2="openarm_right_link5" reason="Never"/>
  <disable_collisions link1="openarm_right_link3" link2="openarm_right_link5" reason="Never"/>
  <disable_collisions link1="openarm_right_link3" link2="openarm_right_link6" reason="Never"/>
  <disable_collisions link1="openarm_right_link4" link2="openarm_right_link6" reason="Never"/>
  <disable_collisions link1="openarm_right_link4" link2="openarm_right_link7" reason="Never"/>
  <disable_collisions link1="openarm_right_link5" link2="openarm_right_link7" reason="Never"/>

  <disable_collisions link1="openarm_base_link" link2="openarm_left_link0" reason="Never"/>
  <disable_collisions link1="openarm_base_link" link2="openarm_right_link0" reason="Never"/>

  <!-- ============================================ -->
  <!-- AMAZING HAND FINGER SELF-COLLISION (ee_type:=amazing_hand only)      -->
  <!-- Cylinder collision primitives were added to each finger's proximal/ -->
  <!-- distal links (see hand_kinematics_node / add_finger_collision.py).  -->
  <!-- Adjacent same-finger segments (gimbal<->proximal, proximal<->distal) -->
  <!-- always touch at the joint, so disable those pairs here to avoid     -->
  <!-- false "always colliding" noise; cross-finger and cross-hand pairs   -->
  <!-- stay checked, which is the actual point of adding this geometry.    -->
  <!-- ============================================ -->
  <disable_collisions link1="openarm_left_ahand_gimbal" link2="openarm_left_ahand_proximal" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_proximal" link2="openarm_left_ahand_distal" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_gimbal_1" link2="openarm_left_ahand_proximal_1" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_proximal_1" link2="openarm_left_ahand_distal_1" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_gimbal_2" link2="openarm_left_ahand_proximal_2" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_proximal_2" link2="openarm_left_ahand_distal_2" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_gimbal_3" link2="openarm_left_ahand_proximal_3" reason="Adjacent"/>
  <disable_collisions link1="openarm_left_ahand_proximal_3" link2="openarm_left_ahand_distal_3" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_gimbal" link2="openarm_right_ahand_proximal" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_proximal" link2="openarm_right_ahand_distal" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_gimbal_1" link2="openarm_right_ahand_proximal_1" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_proximal_1" link2="openarm_right_ahand_distal_1" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_gimbal_2" link2="openarm_right_ahand_proximal_2" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_proximal_2" link2="openarm_right_ahand_distal_2" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_gimbal_3" link2="openarm_right_ahand_proximal_3" reason="Adjacent"/>
  <disable_collisions link1="openarm_right_ahand_proximal_3" link2="openarm_right_ahand_distal_3" reason="Adjacent"/>

  <!-- Virtual joints -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="openarm_base_link"/>

</robot>

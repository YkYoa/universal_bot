<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="openarm_bimanual_ros2_control"
         params="arm_type
             control_gains
             left_can_interface:=^|can1
             right_can_interface:=^|can0
             use_fake_hardware:=^|false
             head_use_fake_hardware:=^|false
             use_isaac_sim:=^|false
             fake_sensor_commands:=^|false
             hand:=^|false
             ee_type:=^|openarm_hand
             left_arm_prefix:=^|left_
             right_arm_prefix:=^|right_
             gazebo:=^|false
             can_fd:=^|true
             shutdown_disable_retries:=^|3
             shutdown_retry_delay_ms:=^|100
             body_type:=^|v1
             no_prefix:=^|false">

    <xacro:property name="body_joint_prefix" value="${'' if no_prefix else 'openarm_body_'}" />

    <xacro:macro name="configure_arm_joint" params="joint_name initial_position">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">${initial_position}</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <ros2_control name="openarm_left_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>
          <xacro:if value="${use_isaac_sim}">
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/isaac_left_arm/joint_commands</param>
            <param name="joint_states_topic">/isaac_left_arm/joint_states</param>
          </xacro:if>
          <xacro:unless value="${use_isaac_sim}">
            <xacro:if value="${use_fake_hardware}">
              <plugin>mock_components/GenericSystem</plugin>
              <param name="fake_sensor_commands">${fake_sensor_commands}</param>
              <param name="state_following_offset">0.0</param>
            </xacro:if>
            <xacro:unless value="${use_fake_hardware}">
              <xacro:if value="${gazebo}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
              </xacro:if>
              <xacro:unless value="${gazebo}">
                <plugin>openarm_hardware/OpenArm_v10HW</plugin>
                <param name="can_interface">${left_can_interface}</param>
                <param name="arm_prefix">${left_arm_prefix}</param>
                <param name="hand">${hand}</param>
                <param name="can_fd">${can_fd}</param>
                <param name="shutdown_disable_retries">${shutdown_disable_retries}</param>
                <param name="shutdown_retry_delay_ms">${shutdown_retry_delay_ms}</param>
                <param name="kp1">${control_gains['joint1']['kp']}</param>
                <param name="kp2">${control_gains['joint2']['kp']}</param>
                <param name="kp3">${control_gains['joint3']['kp']}</param>
                <param name="kp4">${control_gains['joint4']['kp']}</param>
                <param name="kp5">${control_gains['joint5']['kp']}</param>
                <param name="kp6">${control_gains['joint6']['kp']}</param>
                <param name="kp7">${control_gains['joint7']['kp']}</param>
                <param name="kd1">${control_gains['joint1']['kd']}</param>
                <param name="kd2">${control_gains['joint2']['kd']}</param>
                <param name="kd3">${control_gains['joint3']['kd']}</param>
                <param name="kd4">${control_gains['joint4']['kd']}</param>
                <param name="kd5">${control_gains['joint5']['kd']}</param>
                <param name="kd6">${control_gains['joint6']['kd']}</param>
                <param name="kd7">${control_gains['joint7']['kd']}</param>
              </xacro:unless>
            </xacro:unless>
          </xacro:unless>
        </hardware>

      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint1" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint2" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint3" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint4" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint5" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint6" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}joint7" initial_position="0.0"/>

    </ros2_control>

    <!-- LEFT GRIPPER -->
    <xacro:if value="${hand and ee_type == 'openarm_hand'}">
      <ros2_control name="openarm_left_gripper_hardware_interface" type="system">
        <hardware>
          <xacro:if value="${use_isaac_sim}">
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/isaac_left_gripper/joint_commands</param>
            <param name="joint_states_topic">/isaac_left_gripper/joint_states</param>
          </xacro:if>
          <xacro:unless value="${use_isaac_sim}">
            <xacro:if value="${use_fake_hardware}">
              <plugin>mock_components/GenericSystem</plugin>
              <param name="fake_sensor_commands">${fake_sensor_commands}</param>
              <param name="state_following_offset">0.0</param>
            </xacro:if>
            <xacro:unless value="${use_fake_hardware}">
              <xacro:if value="${gazebo}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
              </xacro:if>
              <xacro:unless value="${gazebo}">
                <!-- Real robot driver if applicable -->
                <plugin>mock_components/GenericSystem</plugin>
              </xacro:unless>
            </xacro:unless>
          </xacro:unless>
        </hardware>
        <!-- finger_joint1 is the real motor: owned by openarm_left_hardware_interface
             (OpenArm_v10HW) whenever hand=true, so only declare it here on the
             fake/gazebo path - declaring it in both components crashes
             controller_manager with a duplicate CommandInterface key. -->
        <xacro:if value="${use_isaac_sim or use_fake_hardware or gazebo}">
          <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}finger_joint1" initial_position="0.0" />
        </xacro:if>
        <xacro:configure_arm_joint joint_name="openarm_${left_arm_prefix}finger_joint2" initial_position="0.0" />
      </ros2_control>
    </xacro:if>

    <ros2_control name="openarm_right_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>
          <xacro:if value="${use_isaac_sim}">
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/isaac_right_arm/joint_commands</param>
            <param name="joint_states_topic">/isaac_right_arm/joint_states</param>
          </xacro:if>
          <xacro:unless value="${use_isaac_sim}">
            <xacro:if value="${use_fake_hardware}">
              <plugin>mock_components/GenericSystem</plugin>
              <param name="fake_sensor_commands">${fake_sensor_commands}</param>
              <param name="state_following_offset">0.0</param>
            </xacro:if>
            <xacro:unless value="${use_fake_hardware}">
              <xacro:if value="${gazebo}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
              </xacro:if>
              <xacro:unless value="${gazebo}">
                <plugin>openarm_hardware/OpenArm_v10HW</plugin>
                <param name="can_interface">${right_can_interface}</param>
                <param name="arm_prefix">${right_arm_prefix}</param>
                <param name="hand">${hand}</param>
                <param name="can_fd">${can_fd}</param>
                <param name="shutdown_disable_retries">${shutdown_disable_retries}</param>
                <param name="shutdown_retry_delay_ms">${shutdown_retry_delay_ms}</param>
                <param name="kp1">${control_gains['joint1']['kp']}</param>
                <param name="kp2">${control_gains['joint2']['kp']}</param>
                <param name="kp3">${control_gains['joint3']['kp']}</param>
                <param name="kp4">${control_gains['joint4']['kp']}</param>
                <param name="kp5">${control_gains['joint5']['kp']}</param>
                <param name="kp6">${control_gains['joint6']['kp']}</param>
                <param name="kp7">${control_gains['joint7']['kp']}</param>
                <param name="kd1">${control_gains['joint1']['kd']}</param>
                <param name="kd2">${control_gains['joint2']['kd']}</param>
                <param name="kd3">${control_gains['joint3']['kd']}</param>
                <param name="kd4">${control_gains['joint4']['kd']}</param>
                <param name="kd5">${control_gains['joint5']['kd']}</param>
                <param name="kd6">${control_gains['joint6']['kd']}</param>
                <param name="kd7">${control_gains['joint7']['kd']}</param>
              </xacro:unless>
            </xacro:unless>
          </xacro:unless>
        </hardware>

      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint1" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint2" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint3" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint4" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint5" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint6" initial_position="0.0"/>
      <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}joint7" initial_position="0.0"/>

    </ros2_control>

    <!-- RIGHT GRIPPER -->
    <xacro:if value="${hand and ee_type == 'openarm_hand'}">
      <ros2_control name="openarm_right_gripper_hardware_interface" type="system">
        <hardware>
          <xacro:if value="${use_isaac_sim}">
            <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
            <param name="joint_commands_topic">/isaac_right_gripper/joint_commands</param>
            <param name="joint_states_topic">/isaac_right_gripper/joint_states</param>
          </xacro:if>
          <xacro:unless value="${use_isaac_sim}">
            <xacro:if value="${use_fake_hardware}">
              <plugin>mock_components/GenericSystem</plugin>
              <param name="fake_sensor_commands">${fake_sensor_commands}</param>
              <param name="state_following_offset">0.0</param>
            </xacro:if>
            <xacro:unless value="${use_fake_hardware}">
              <xacro:if value="${gazebo}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
              </xacro:if>
              <xacro:unless value="${gazebo}">
                <!-- Real robot driver if applicable -->
                <plugin>mock_components/GenericSystem</plugin>
              </xacro:unless>
            </xacro:unless>
          </xacro:unless>
        </hardware>
        <!-- finger_joint1 is the real motor: owned by openarm_right_hardware_interface
             (OpenArm_v10HW) whenever hand=true, so only declare it here on the
             fake/gazebo path - declaring it in both components crashes
             controller_manager with a duplicate CommandInterface key. -->
        <xacro:if value="${use_isaac_sim or use_fake_hardware or gazebo}">
          <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}finger_joint1" initial_position="0.0" />
        </xacro:if>
        <xacro:configure_arm_joint joint_name="openarm_${right_arm_prefix}finger_joint2" initial_position="0.0" />
      </ros2_control>
    </xacro:if>

    <ros2_control name="openarm_base_hardware_interface" type="system">
        <hardware>
          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <xacro:if value="${gazebo}">
              <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="${gazebo}">
              <!-- Ở thực tế, bạn có thể thay thế driver thật cho đế xe ở đây nếu có -->
              <plugin>mock_components/GenericSystem</plugin> 
            </xacro:unless>
          </xacro:unless>
        </hardware>

        <joint name="openarm_base_left_drive_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/> 
            <state_interface name="position"/>
        </joint>

        <joint name="openarm_base_right_drive_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/> 
            <state_interface name="position"/>
        </joint>

        <joint name="openarm_base_fl_caster_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_fr_caster_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_bl_caster_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_br_caster_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_fl_wheel_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_fr_wheel_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_bl_wheel_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
        <joint name="openarm_base_br_wheel_joint"><state_interface name="position"><param name="initial_value">0.0</param></state_interface></joint>
    </ros2_control>

    <!-- body v2's articulated neck + head; no-op for v1 (rigid body has no such joints) -->
    <xacro:if value="${body_type == 'v2'}">
      <ros2_control name="openarm_head_hardware_interface" type="system">
        <hardware>
          <!-- Decoupled from arms/hands' use_fake_hardware - driven by
               hardware_config.yaml + live ethernet detection in
               openarm_hardware/launch/bringup.launch.py, since the head
               board can be real while arms/hands aren't physically present
               (and vice versa). -->
          <xacro:if value="${head_use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${head_use_fake_hardware}">
            <xacro:if value="${gazebo}">
              <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="${gazebo}">
              <plugin>openarm_hardware/HeadHW</plugin>
              <param name="socket_path">/tmp/openarm_head_motor.sock</param>
              <!-- EMA smoothing on raw position feedback (1.0=off, lower=more
                   smoothing/lag). Fixes joint_states/RViz showing jitter that
                   isn't real head motion; tune here without a C++ rebuild. -->
              <param name="position_filter_alpha">0.4</param>
            </xacro:unless>
          </xacro:unless>
        </hardware>
        <xacro:configure_arm_joint joint_name="${body_joint_prefix}neck_joint" initial_position="0.0"/>
        <xacro:configure_arm_joint joint_name="${body_joint_prefix}head_joint" initial_position="0.0"/>
      </ros2_control>
    </xacro:if>
  </xacro:macro>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(find arm_control)/config/bimanual_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
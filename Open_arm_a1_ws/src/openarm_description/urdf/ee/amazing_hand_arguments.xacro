<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Where is the end-effector connected to, if different from the robot flange?  -->
  <xacro:arg name="special_connection" default="" />

  <!-- Position offset between the arm's wrist flange and the hand's root link.
       Not yet calibrated against real hardware: the standalone amazing_hand
       display/control launches place root at the world origin directly, so
       this mount transform is an untested placeholder. Expect to tune it. -->
  <xacro:arg name="xyz_ee" default="0 0 0" />
  <xacro:arg name="rpy_ee" default="0 0 0" />

  <!-- Position/rotation offset between ee frame and tcp frame, unused by
       amazing_hand today; kept for interface parity with openarm_hand. -->
  <xacro:arg name="tcp_xyz" default="0 0 0" />
  <xacro:arg name="tcp_rpy" default="0 0 0" />

  <!-- Name of the description package -->
  <xacro:arg name="description_pkg" default="openarm_description" />

</robot>

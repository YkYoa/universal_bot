# =============================================================================
# Docker for OpenArm RViz2 UI Development (WSL2 on Windows)
# =============================================================================
# This image is for UI designers running WSL2 on Windows.
# It provides ROS 2 Jazzy + MoveIt 2 + RViz2 with GUI forwarding via WSLg.
# 
# Architecture:
#   Your teammate (WSL/Windows) <-- Docker (this) --> RViz2 GUI
#   Hans (Ubuntu 24.04)         <-- native ROS 2   --> Robot (IQ 9075)
# =============================================================================

FROM osrf/ros:jazzy-desktop-full

# ---------- Create non-root user matching typical WSL UID/GID ----------------
ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# ---------- Install system dependencies --------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    # MoveIt 2 (required for this project)
    ros-jazzy-moveit \
    ros-jazzy-moveit-ros-visualization \
    ros-jazzy-moveit-planners-ompl \
    ros-jazzy-moveit-simple-controller-manager \
    # ROS 2 control stack
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-joint-state-publisher-gui \
    # Xacro for URDF
    ros-jazzy-xacro \
    # GUI / OpenGL support for RViz2 on WSLg
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    libegl1-mesa \
    libgles2-mesa \
    mesa-utils \
    x11-apps \
    # Utilities
    git \
    nano \
    curl \
    wget \
    iputils-ping \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# ---------- Switch to non-root user ------------------------------------------
USER $USERNAME

# ---------- Set up workspace -------------------------------------------------
ENV WORKSPACE=/home/$USERNAME/ws
RUN mkdir -p $WORKSPACE/src
WORKDIR $WORKSPACE

# rosdep update must run as non-root
RUN rosdep update

# ---------- Display & shell config -------------------------------------------
ENV DISPLAY=:0
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_INDIRECT=0
ENV SHELL=/bin/bash

# Source ROS 2 + workspace overlay automatically
RUN echo "source /opt/ros/jazzy/setup.bash" >> /home/$USERNAME/.bashrc \
    && echo 'if [ -f $WORKSPACE/install/setup.bash ]; then source $WORKSPACE/install/setup.bash; fi' >> /home/$USERNAME/.bashrc \
    && echo 'echo "🤖 OpenArm WSL Docker — ROS 2 Jazzy ready"' >> /home/$USERNAME/.bashrc

CMD ["sleep", "infinity"]

<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_base">

  <xacro:include filename="$(find openarm_description)/urdf/base/openarm_base.xacro" />

  <xacro:openarm_base
    description_pkg="openarm_description"
    connected_to="world"
    xyz="0 0 0"
    rpy="0 0 0" />

</robot>

# OpenArm RL — copy to openarm.env và chỉnh theo máy bạn:
#   cp openarm.env.example openarm.env
#
# openarm.env không commit (chứa path cá nhân).

# SSH alias trong ~/.ssh/config (vd. Host huyhoang-4090)
export OPENARM_SERVER=huyhoang-4090

# Isaac Sim local (laptop 4050) — dùng bởi ./rl.sh demo / local-train
export ISAAC_SIM_PYTHON=/home/hans/isaacsim/isaac-sim-standalone-5.1.0-linux-x86_64/python.sh

# Override workspace server (mặc định: /data21tb/users/$(whoami)/openarm_train_ws)
# export OPENARM_REMOTE_ROOT=/data21tb/users/huyhoang/openarm_train_ws

# Isaac Sim trên server — chỉ khi deploy không tự tìm được python.sh
# export OPENARM_SERVER_PYTHON=/data21tb/users/huyhoang/isaacsim/python.sh

# Sync Isaac Lab lên server (lần đầu / thiếu trên server)
# export OPENARM_SYNC_ISAACLAB=1
# export OPENARM_LOCAL_ISAACLAB=$HOME/IsaacLab
